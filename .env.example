# Supabase Postgres connection.
# Prefer the Session pooler URI for a long-running backend.
# Copy from Supabase Dashboard -> Connect -> Session pooler.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# NASA FIRMS API key used by the automatic ingestion loop.
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY
